generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  sessionVersion Int @default(0)
  avatarUrl    String?
  age          Int?
  xp           Int      @default(0)
  level        Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  activities       Activity[]
  plannedActivities PlannedActivity[]
  userAchievements UserAchievement[]
  streaks          Streak[]
  xpHistory        XpHistory[]
  goals            Goal[]
  passwordResetTokens PasswordResetToken[]
  mutationReceipts MutationReceipt[]
  completionUndos CompletionUndo[]
  avatar Avatar?
}

model Avatar {
  id String @id @default(uuid())
  userId String @unique
  data Bytes
  contentType String
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CompletionUndo {
  activityId String @id
  userId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model MutationReceipt {
  id String @id @default(uuid())
  userId String
  key String
  requestHash String
  response Json
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt, expiresAt])
}

model Activity {
  id          String       @id @default(uuid())
  userId      String
  type        ActivityType
  title       String
  description String?
  streakDate DateTime?
  goalContributions Json @default("[]")
  xpEarned    Int
  hiddenAt    DateTime?
  duration    Int?
  plannedActivityId String?
  completedForDate DateTime?
  completedAt DateTime     @default(now())
  createdAt   DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plannedActivity PlannedActivity? @relation(fields: [plannedActivityId], references: [id], onDelete: SetNull)
  translations ActivityTranslation[]

  @@unique([userId, plannedActivityId, completedForDate])
  @@index([plannedActivityId])
  @@index([userId, completedAt])
}

model ActivityTranslation {
  id          String @id @default(uuid())
  activityId  String
  locale      String
  title       String
  description String?
  sourceHash  String

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([activityId, locale])
  @@index([activityId, sourceHash])
}

enum ActivityType {
  STUDY
  WORKOUT
  HABIT
  CUSTOM
}

model PlannedActivity {
  id             String                      @id @default(uuid())
  userId         String
  type           ActivityType
  title          String
  description    String?
  motivationText String?
  scheduleType   PlannedActivityScheduleType @default(SIMPLE)
  weekdays       Int[] @default([])
  scheduleHistory Json @default("[]")
  dueDate        DateTime?
  dueTimeMinutes Int?
  timezone       String                      @default("UTC")
  status         PlannedActivityStatus       @default(ACTIVE)
  completedAt    DateTime?
  disabledAt     DateTime?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  completedActivities Activity[]
  translations PlannedActivityTranslation[]

  @@index([userId, status])
  @@index([userId, scheduleType])
  @@index([userId, status, dueDate, createdAt])
}

model PlannedActivityTranslation {
  id                String @id @default(uuid())
  plannedActivityId String
  locale            String
  title             String
  description       String?
  motivationText    String?
  sourceHash        String

  plannedActivity PlannedActivity @relation(fields: [plannedActivityId], references: [id], onDelete: Cascade)

  @@unique([plannedActivityId, locale])
  @@index([plannedActivityId, sourceHash])
}

enum PlannedActivityScheduleType {
  SIMPLE
  DAILY
  WEEKLY
  DATE
}

enum PlannedActivityStatus {
  ACTIVE
  COMPLETED
  DISABLED
}

model Achievement {
  id          String @id @default(uuid())
  code        String @unique
  name        String
  description String
  iconEmoji   String @default("🏆")
  xpReward    Int    @default(0)
  condition   String

  userAchievements UserAchievement[]
  translations AchievementTranslation[]
}

model AchievementTranslation {
  id            String @id @default(uuid())
  achievementId String
  locale        String
  name          String
  description   String

  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([achievementId, locale])
}

model UserAchievement {
  id            String   @id @default(uuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
}

model Streak {
  id               String    @id @default(uuid())
  userId           String
  type             String    @default("daily")
  currentCount     Int       @default(0)
  longestCount     Int       @default(0)
  lastActivityDate DateTime?
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

model XpHistory {
  id        String   @id @default(uuid())
  userId    String
  amount    Int
  reason    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Goal {
  id           String       @id @default(uuid())
  userId       String
  title        String
  progressBaseCount Int @default(0)
  progressVersion Int @default(0)
  targetCount  Int
  currentCount Int          @default(0)
  type         ActivityType
  deadline     DateTime?
  isCompleted  Boolean      @default(false)
  createdAt    DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

generator erd {

  provider = "prisma-erd-generator"

  output   = "./ERD.svg"

}
