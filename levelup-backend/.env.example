DATABASE_URL="postgresql://postgres:replace-with-password@localhost:5432/levelup?connection_limit=10&pool_timeout=5&connect_timeout=5"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"
PORT=3000
OPENAI_API_KEY="replace-with-openai-api-key"
OPENAI_MODEL="gpt-5.4-mini"
PASSWORD_RESET_URL_BASE="https://YOUR_PUBLIC_API_DOMAIN/reset-password"
PASSWORD_RESET_APP_URL_BASE="levelup://auth/reset-password"
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="replace-with-smtp-user"
SMTP_PASS="replace-with-smtp-password"
SMTP_FROM="LevelUp <no-reply@example.com>"

# Set only when your ingress topology is known; Render uses one reverse proxy.
# TRUST_PROXY_HOPS=1
# Legacy avatar directory for migration. New avatars are stored in PostgreSQL.
# UPLOADS_DIR=/absolute/path/to/uploads
