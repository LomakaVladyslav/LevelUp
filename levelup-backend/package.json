{
  "name": "levelup-backend",
  "version": "1.0.0",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "generate": "prisma generate --schema prisma/schema.prisma --generator client",
    "prebuild": "npm run generate",
    "build": "tsc",
    "pretest": "npm run generate",
    "test": "node --test -r ts-node/register src/**/*.test.ts",
    "start": "node dist/index.js",
    "seed": "ts-node prisma/seed.ts",
    "test:db": "node scripts/test-db.cjs",
    "lint": "eslint . --max-warnings 0",
    "audit:data": "node scripts/audit-data.cjs",
    "migrate:avatars": "node scripts/migrate-avatars.cjs"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.1",
    "openai": "^6.39.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.10.0",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^10.10.0",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  },
  "description": "",
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "overrides": {
    "qs": "^6.16.0"
  }
}
