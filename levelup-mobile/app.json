{
  "expo": {
    "name": "LevelUp",
    "slug": "levelup",
    "version": "1.0.0",
    "scheme": "levelup",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#6C47FF"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow LevelUp to access your photos so you can choose an avatar.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store"
    ],
    "android": {
      "package": "com.vladyslav.levelup",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6C47FF"
      }
    },
    "ios": {
      "bundleIdentifier": "com.vladyslav.levelup",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "1327d425-598b-434c-b9a4-2a556e6bc864"
      }
    }
  }
}
