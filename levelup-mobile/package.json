{
  "name": "levelup-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start -c",
    "start:tunnel": "expo start -c --tunnel",
    "start:dev-client": "expo start --dev-client -c",
    "android": "expo start --android",
    "android:dev": "expo run:android --device",
    "ios": "expo start --ios",
    "ios:dev": "expo run:ios --device",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/datetimepicker": "8.0.1",
    "axios": "^1.6.2",
    "expo": "~51.0.0",
    "expo-dev-client": "~4.0.29",
    "expo-image-picker": "~15.1.0",
    "expo-linking": "~6.3.1",
    "expo-notifications": "~0.28.19",
    "expo-router": "~3.5.0",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "victory-native": "^41.1.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@testing-library/react-native": "^12.4.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/react": "~18.2.45",
    "jest": "^29.7.0",
    "jest-expo": "~51.0.4",
    "react-test-renderer": "^18.2.0",
    "typescript": "~5.3.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo/.*|expo-modules-core|expo-router|@react-navigation/.*|react-native-reanimated|react-native-safe-area-context|react-native-svg)/)"
    ]
  }
}
