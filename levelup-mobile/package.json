{
  "name": "levelup-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start -c",
    "start:tunnel": "expo start -c --tunnel",
    "start:dev-client": "expo start --dev-client -c",
    "android": "expo start --android",
    "android:dev": "expo run:android --device",
    "ios": "expo start --ios",
    "ios:dev": "expo run:ios --device",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "axios": "^1.6.2",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.18",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/react": "~19.1.10",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "test-renderer": "1.1.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.69.0"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo/.*|expo-modules-core|expo-router|@react-navigation/.*|react-native-reanimated|react-native-safe-area-context|react-native-svg|react-native-worklets)/)"
    ]
  },
  "overrides": {
    "postcss": "^8.5.28",
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
